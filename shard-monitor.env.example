# shard-monitor.env.example
# ----------------------------------------------------------------------
# shard-monitor-standalone.sh 的【独立环境变量说明】(与 fpsync.env 无关)。
# 用法二选一:
#   1) 命令行参数(优先):见 ./shard-monitor-standalone.sh --help
#   2) 这些 MON_* 环境变量(export 后运行,或 `source` 本文件后运行)
# 命令行参数会覆盖同名环境变量。
# ----------------------------------------------------------------------

# 发送机清单(空格分隔的 ssh 目标)。local/localhost=本机;否则 user@host 或 host。
export MON_SENDERS="local"
# 例(跨云多对): export MON_SENDERS="localhost ec2-user@10.0.1.22 ec2-user@10.0.1.23"

# 各发送机上 fpsync 运行目录基准(= shard-plan 的 RUN_DIR_BASE)
export MON_RUN_DIR_BASE="/var/log/fpsync_runs"

# 批次时间戳(目录名 shard_<STAMP>_*);留空=自动取最近一批
export MON_STAMP=""

# 刷新间隔秒;0=只出一次快照
export MON_REFRESH="5"

# 置 1 关闭"各发送端网卡吞吐"采样(省去每发送端 1s 采样)
export MON_NO_NET="0"

# ---- 使用 ----
#   source shard-monitor.env.example   # 或你自己的副本
#   ./shard-monitor-standalone.sh
# 或纯命令行:
#   ./shard-monitor-standalone.sh --senders "localhost ec2-user@10.0.1.22" \
#       --run-dir-base /tmp/fpsync_runs --refresh 5
