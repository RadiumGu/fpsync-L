# fpsync.env
# ----------------------------------------------------------------------
# fpsync 工具集统一环境配置 (复制相关变量的唯一真相源)
#
# 加载方式: 同目录的 source-profile.sh / generate-fpsync-cmd.sh /
#           fpsync-monitor*.sh 以及生成的 run.sh 都会自动 source 本文件。
#
# 优先级: 配置文件优先 (authoritative)。脚本里对每个变量套
#         ${VAR:-默认} 兜底;位置参数仅在对应配置项【留空】时作为回退。
#
# 留空语义:
#   - 路径/监控类留空 -> 使用脚本内置默认值或回退到位置参数。
#   - 调优参数(JOBS/FILES_PER_PART/SIZE_PER_PART/RSYNC_OPTS/FPART_OPTS)
#     留空 -> generate-fpsync-cmd.sh 按源端画像【自动推导】,
#     并把推导出的最终值【回写】到本文件(填充这些留空字段)。
#
# 注意: 本文件用 shell 语法,值含空格请加引号。不要写 `export`,
#       脚本用 source 加载即可。AWS 资源清理 ID 不在本文件范围。
# ----------------------------------------------------------------------

# ---- 路径 / 源目的 ----
SRC_DIR="/mnt/src/data/"            # 源目录(扫描 + 同步源), e.g. /mnt/src/data/
DST_DIR="/mnt/dst/"            # 目的目录;本地路径 e.g. /mnt/dst/  或【远程】 user@host:/mnt/efs/dst/
WORKDIR="/home/ec2-user/fpsync_profile"            # 画像工作目录, 留空默认 /tmp/fpsync_profile
PROFILE_JSON=""       # profile.json 路径, 留空默认 ${WORKDIR}/profile.json
SCAN_PARALLEL=""      # source-profile 并行扫描度(按顶层子目录并行 find);留空=按 CPU 自动(核数×4,下限4)

# ---- 监控相关 ----
SRC_MOUNT="/mnt/src"          # 源端挂载点(监控用), 留空默认回退到 SRC_DIR
DST_HOST="10.1.2.99"           # 目的端 NFS/rsyncd 主机(跨云迁移目标 IP), 监控网卡吞吐用
FPSYNC_TMPDIR="/tmp/fpsync"      # fpsync -t 临时目录(queue/work/done), 留空默认 /tmp/fpsync
FPSYNC_SHARED_DIR=""  # fpsync -d 共享目录(parts/log), 留空默认 = FPSYNC_TMPDIR

# ---- 调优参数(留空 = 自动推导, 由 generate 回写) ----
JOBS="4"   # fpsync -n  并发 worker 数
FILES_PER_PART="1000"   # fpsync -f  每分区文件数
SIZE_PER_PART="4g"   # fpsync -s  每分区字节数, e.g. 4g / 512m / 20g
RSYNC_OPTS="-lptgoD --numeric-ids --inplace --whole-file"   # fpsync -o  rsync 透传选项, e.g. -lptgoD --numeric-ids --inplace
FPART_OPTS="-x|.zfs|-x|.snapshot*|-x|.ckpt"   # fpsync -O  fpart 选项/排除项, e.g. -x|.zfs|-x|.snapshot*|-x|.ckpt

# ---- 跨云 / 远程传输(可选;两项留空 = 本地模式,行为不变)----
# 当 DST_DIR 为远程 user@host:/path 时,rsync 经 SSH 推送(适合 GCP→AWS 等跨云)。
RSYNC_SSH=""     # 远程 SSH 传输命令,设置后 run.sh/verify 会 export 成 RSYNC_RSH 供 rsync 使用。
                 # 例: ssh -T -c aes128-gcm@openssh.com -o Compression=no -o ServerAliveInterval=30
BWLIMIT=""       # rsync 限速(保护专线/业务),例: 200m;留空=不限速。运行时追加为 --bwlimit

# ---- 分片(shard-plan.sh)节点清单 ----
# AWS_RECEIVERS: 空格分隔的接收端列表 "user@host:/basepath"(都挂同一个 EFS,不同子路径)
#   e.g. "ec2-user@10.0.1.10:/mnt/efs/dst ec2-user@10.0.2.11:/mnt/efs/dst"
AWS_RECEIVERS=""
# GCP_SENDERS: 空格分隔的发送节点主机(分片器 SSH 过去起 fpsync);留空 = 本机即发送端
#   e.g. "gcp-snd-1 gcp-snd-2"
GCP_SENDERS=""

# ---- 运行目录 / 增量 ----
RUN_DIR_BASE="/tmp/fpsync_runs"           # 每次运行在其下拼 run_<时间戳> 子目录;
                                              # 时间戳由脚本运行时生成,不写进本文件。
LAST_SYNC_MARKER="/home/ec2-user/fpsync_last_sync"  # 增量基线标记(find -newer 用)
